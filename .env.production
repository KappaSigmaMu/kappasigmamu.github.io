REACT_APP_NAME=Kusama Society
REACT_APP_KEYRING_PREFIX=2
REACT_APP_RPC={}

# These keys are read-only, no harm in exposing them
REACT_APP_PINATA_API_KEY="86c94c7482c7ea399726"
REACT_APP_PINATA_API_SECRET="13d5d71e42a838f13f8cafa2f8ebc21b24d4060bbf50a3330ae3d85a07c9c6a7"
REACT_APP_PINATA_GATEWAY="https://azure-above-clam-231.mypinata.cloud"

# Proof-of-Ink. Images live on the Bulletin Chain (Paseo) and are served back through
# its public IPFS gateway; uploads go through the poi-backend service.
REACT_APP_IPFS_GATEWAY=https://paseo-bulletin-next-ipfs.polkadot.io
# Set to the deployed poi-backend URL. Without it the app falls back to
# http://127.0.0.1:8787 and Proof-of-Ink submission will not work in production.
# REACT_APP_POI_BACKEND_URL=https://poi-backend.example.org
